# DB_HOST=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_PORT=5432
# DB_SSLMODE=require
# PostgreSQL always uses the required tugas_kelompok schema.
OFF_USER_AGENT=PandaCrumbs/0.2 (https://github.com/pbp-kelompok-f4/PandaCrumbs)
